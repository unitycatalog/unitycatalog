{
  "name": "uc-ui-new-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "routes": "tsr generate",
    "generate": "cd .. && buf generate",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsr generate && tsc -b",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "test:format": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "clean-bun-lock": "bun run scripts/clean-bun-lock.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.2.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.135.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.58.0",
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/router-cli": "^1.135.0",
    "@tanstack/router-plugin": "^1.135.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.11.14",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
