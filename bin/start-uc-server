#!/bin/bash

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

TARBALL_JAR_DIR="$ROOT_DIR/jars"
SERVER_CLASS_FILE="$ROOT_DIR/server/src/main/java/io/unitycatalog/server/UnityCatalogServer.java"
SAMPLE_DATABASE="$ROOT_DIR/etc/db/h2db.mv.db"

# This function generates the unity catalog jars using sbt
generate_jar() {
  local GENERATE_JAR_COMMAND="$ROOT_DIR/build/sbt -info clean package"
  echo "Running SBT to generate Server JAR: $GENERATE_JAR_COMMAND"
  $GENERATE_JAR_COMMAND || exit
}

# This function builds the quickstart's sample database (etc/db/h2db.mv.db) using sbt. A source
# checkout does not hold it; the tarball and the Docker image ship one.
build_sample_database() {
  local BUILD_SAMPLE_DATABASE_COMMAND="$ROOT_DIR/build/sbt -info buildSampleDatabase"
  echo "Running SBT to build the sample database $SAMPLE_DATABASE: $BUILD_SAMPLE_DATABASE_COMMAND"
  $BUILD_SAMPLE_DATABASE_COMMAND || exit
}

# This function succeeds when the command line starts the server: it holds nothing but the port
# options, in any spelling the option parser takes (one or two dashes, the start of the name, the
# value after a space or an =). A schema command, --version, --help or an unknown option does not
# start it.
starts_server() {
  while [ $# -gt 0 ]; do
    arg=$1
    shift
    case "$arg" in
      -p[0-9]*|-|--) continue ;;
      -*) ;;
      *) continue ;;
    esac
    long=${arg#--}
    name=${long#-}
    name=${name%%=*}
    # A single dash takes a one-letter option only as -p.
    if [ "$long" = "$arg" ] && [ "${#name}" -lt 2 ] && [ "$name" != p ]; then
      return 1
    fi
    case "port" in "$name"*) ;; *) case "obs-port" in "$name"*) ;; *) return 1 ;; esac ;; esac
    case "$arg" in
      *=*) ;;
      *)
        # The value is the next word, which an option does not start.
        [ $# -ge 1 ] || return 1
        case "$1" in -*) return 1 ;; esac
        shift
        ;;
    esac
  done
}

# This function starts the unity catalog server. exec makes the JVM this process, so it receives
# SIGTERM itself (as PID 1 in a container) and drains before exiting. The server stops Log4j after
# that drain, so Log4j's own shutdown hook, which would stop logging during it, is off.
run_uc_server_java_command() {
  SERVER_JAVA_COMMAND="java -Dlog4j2.shutdownHookEnabled=false -cp $(cat "$1") io.unitycatalog.server.UnityCatalogServer"
  shift
  exec $SERVER_JAVA_COMMAND "$@"
}

# This function runs the server using the source code
run_in_source_code() {
  SERVER_TARGET_DIR="$ROOT_DIR/server/target"
  SERVER_JAR=$(find "$SERVER_TARGET_DIR" -name "unitycatalog-server*.jar" | head -n 1)

  if [ -z "$SERVER_JAR" ]; then
      echo "Server JAR not found starting with 'unitycatalog-server*' in the target directory '$SERVER_TARGET_DIR'."
      generate_jar
  fi

  SERVER_CLASSPATH_FILE="$SERVER_TARGET_DIR/classpath"
  if [ -z "$SERVER_CLASSPATH_FILE" ]; then
      echo "No classpath file found in the target directory '$SERVER_TARGET_DIR'."
      generate_jar
  fi

  # The Docker image holds the server's sources but not build/sbt: it ships its sample database,
  # and a volume mounted over etc/db stays empty.
  # Only a command line that starts the server uses the sample database.
  if [ ! -f "$SAMPLE_DATABASE" ] && [ -x "$ROOT_DIR/build/sbt" ] && starts_server "$@"; then
      echo "Sample database '$SAMPLE_DATABASE' not found."
      build_sample_database
  fi

  run_uc_server_java_command "$SERVER_CLASSPATH_FILE" "$@"
}

# This function runs the server using the tarball
run_in_tarball() {
  SERVER_CLASSPATH_FILE=$(find "$TARBALL_JAR_DIR" -name "classpath" | head -n 1)
  run_uc_server_java_command "$SERVER_CLASSPATH_FILE" "$@"
}

# Check if TARBALL_JAR_DIR exists, then we are running in the tarball
if [ -d "$TARBALL_JAR_DIR" ]; then
  run_in_tarball "$@"
# Check if SERVER_CLASS_FILE exists, then we are running in the source code
elif [ -f "$SERVER_CLASS_FILE" ]; then
  run_in_source_code "$@"
else
  echo "Script running neither in source code nor in tarball"
fi